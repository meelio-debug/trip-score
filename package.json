{
  "name": "trip-score",
  "version": "0.0.1",
  "private": true,
  "description": "7-day activity rankings for any city, scored from weather forecasts.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @trip-score/api dev\" \"pnpm --filter @trip-score/web dev\"",
    "dev:api": "pnpm --filter @trip-score/api dev",
    "dev:web": "pnpm --filter @trip-score/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
